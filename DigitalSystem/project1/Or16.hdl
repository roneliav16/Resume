// File name: projects/1/Or16.hdl
/**
 * 16-bit Or gate:
 * for i = 0, ..., 15:
 * out[i] = a[i] Or b[i] 
 */
CHIP Or16 {
    IN a[16], b[16];
    OUT out[16];

    PARTS:
    Not16(in=a, out=not16a);
    Not16(in=b, out=not16b);
    And16(a=not16a, b=not16b, out=not16aAndnot16b);
    Not16(in=not16aAndnot16b, out=out);
}