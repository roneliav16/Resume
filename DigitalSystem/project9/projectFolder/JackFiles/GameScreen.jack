    function boolean printSquare(Square square, boolean squareBlink) {
        if (squareBlink = true) {
            do square.draw();
            return false;
        } else {
            do square.erase();
            return true;
        }
    }

    function void printDiscovered(Array discover) {
        // gameScreen(arr1 - discover) 
        // print discover 
        // if num print num 1-8  
        // if not disovered print nothing 
        // if 0 and discovered do nothing  
        // if flag 10 print flag 
        var int i, j, val;
        var int pixI, pixJ;
        var int col, row;
        var int loc; 
        var Array rowTemp;
        let i = 0;
        let j = 0;

        while(i < 9) {
            let rowTemp = discover[i];
            while(j < 9) {
                let val = rowTemp[j];
               
                let row = 30 + 5 + (23 * i);
                let col = 154 + 14 + (27 * j); 
                if (j = 5) {
                    let col = col + 4; 
                }
                if (j = 2) {
                    let col = col + 2; 
                }
                if (j = 8) {
                    let col = col - 2; 
                }

                let pixI = 32 * row;
                let pixJ = col / 16;
                let loc = pixI + pixJ;

                if( val > 0 & val < 9) {
                    // print number
                    if (val = 1){
                        do GameScreen.draw1(loc);
                    }
                    if (val = 2){
                        do GameScreen.draw2(loc);
                    }
                    if (val = 3){
                        do GameScreen.draw3(loc);
                    }
                    if (val = 4){
                        do GameScreen.draw4(loc);
                    }
                    if (val = 5){
                        do GameScreen.draw5(loc);
                    }
                    if (val = 6){
                        do GameScreen.draw6(loc);
                    }
                    if (val = 7){
                        do GameScreen.draw7(loc);
                    }
                    if (val = 8){
                        do GameScreen.draw8(loc);
                    }
                }                
                // bomb
                if( val = 9 ){
                    do GameScreen.drawBomb(loc);
                } 
                // flag
                if(val = 10) {
                    // print flag
                    do GameScreen.drawFlag(loc);
                }
                // Old square
                if(val = 11) {
                    // print old square
                    do GameScreen.draw0(loc);
                }
                let j = j + 1; 
            }
            let i = i + 1;
            let j = 0; 
        }
        return;
    }

