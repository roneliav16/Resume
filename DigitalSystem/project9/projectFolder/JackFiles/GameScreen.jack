/** This class managing the game */
class GameScreen {
    function void printScreen() {
        /** This function print 9x9 screen. */
        // do GameScreen.draw(150);
        // do Screen.drawRectangle(128,128 , 255, 255);
        do GameScreen.drawFrame();
        do GameScreen.drawInstructions(3203);
        do GameScreen.drawNames(107, 111, 114);
        return;
    }

    function void drawFrame() {
        var int i;
        // Draws the frames
        do Screen.setColor(true);
        do Screen.drawLine(153, 29, 396, 29);
        do Screen.drawLine(153, 29, 153, 236);
        do Screen.drawLine(153, 236, 396, 236);
        do Screen.drawLine(396, 29, 396, 236);

        // Draws the lines between each square.
        let i = 1;
        while (i < 9) { // draw the horizontal lines.
            do Screen.drawLine(153, 29 + (i * 23), 395, 29 + (i * 23));
            let i = i + 1;
        } 

        let i = 1;
        while (i < 9) { // Draws the vertical lines.
            do Screen.drawLine(153 + (i * 27) , 29, 153 + (i * 27), 236);
            let i = i + 1;
        } 
        do Screen.drawLine(153, 29, 396, 29);
        do Screen.drawLine(153, 29, 153, 236);
        do Screen.drawLine(153, 236, 396, 236);
        do Screen.drawLine(396, 29, 396, 236);
        return;
    }

