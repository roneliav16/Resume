// File name: projects/3/a/PC.hdl
/**
 * A 16-bit counter.
 * if      reset(t): out(t+1) = 0
 * else if load(t):  out(t+1) = in(t)
 * else if inc(t):   out(t+1) = out(t) + 1
 * else              out(t+1) = out(t)
 */
CHIP PC {
    IN in[16], reset, load, inc;
    OUT out[16];
    
    PARTS:
    Mux16(a=outloop , b= false, sel=reset , out=out1 );
    Mux(a=load , b=false , sel=reset , out=load1 );
    Mux(a=inc , b=false , sel=reset , out=inc1 );

    Mux16(a=out1 , b= in, sel=load1 , out=out2 );
    Mux(a=inc1 , b=false , sel=load1 , out=inc2);

    Inc16(in=out2 , out=inPlus1 );
    Mux16(a=out2 , b= inPlus1, sel=inc2 , out=out3 );

    Register(in=out3 , load=true , out=outloop , out=out);
}